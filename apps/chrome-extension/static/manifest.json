{
  "manifest_version": 3,
  "name": "Submarine",
  "description": "Locally translate audio from the active Chrome tab into English.",
  "version": "0.1.4",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "tabCapture"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Submarine live translation",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:8765"
  }
}
