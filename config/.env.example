# The backend accepts loopback IP addresses only.
SUBMARINE_HOST=127.0.0.1
SUBMARINE_PORT=8765
SUBMARINE_LOG_LEVEL=info
SUBMARINE_MODEL_PATH=../../var/models/faster-whisper-large-v3
SUBMARINE_MODEL_NAME=Systran/faster-whisper-large-v3
SUBMARINE_MODEL_DEVICE=cuda
SUBMARINE_MODEL_COMPUTE_TYPE=float16
# Optional local final-sentence enforcement. Provisional text never uses Ollama.
SUBMARINE_OLLAMA_CLEANUP_ENABLED=false
SUBMARINE_OLLAMA_URL=http://127.0.0.1:11434
SUBMARINE_OLLAMA_MODEL=translategemma:4b
SUBMARINE_OLLAMA_TIMEOUT_SECONDS=30

# --- Whisper decoding (SUB-013) ---
# Force the spoken language (two-letter code). Empty = automatic detection.
# The overlay entry "Auto" falls back to this value.
SUBMARINE_SOURCE_LANGUAGE=
# Prompt in the SPOKEN language: biases the original-language transcript.
SUBMARINE_INITIAL_PROMPT=
# Prompt in ENGLISH: biases names and terms of the English translation.
SUBMARINE_TRANSLATION_PROMPT=
# Segments above/below these confidence limits are discarded.
SUBMARINE_NO_SPEECH_THRESHOLD=0.6
SUBMARINE_LOG_PROB_THRESHOLD=-1.0
# Silero VAD inside faster-whisper. Higher threshold = stricter speech detection.
SUBMARINE_VAD_THRESHOLD=0.5
SUBMARINE_VAD_MIN_SILENCE_MS=500
SUBMARINE_VAD_MIN_SPEECH_MS=0
SUBMARINE_VAD_SPEECH_PAD_MS=400
# Energy gate before Whisper (RMS 0..1). Raise it when quiet background audio
# (television, music) keeps opening segments.
SUBMARINE_SPEECH_RMS_THRESHOLD=0.008
# Comma-separated names/terms the Ollama cleanup must spell exactly like this.
SUBMARINE_GLOSSARY=
# whisper = direct Whisper translation. ollama = final segments are transcribed in
# the source language and translated by the local Ollama model (requires
# SUBMARINE_OLLAMA_CLEANUP_ENABLED=true; falls back to whisper on errors).
SUBMARINE_TRANSLATION_MODE=whisper
